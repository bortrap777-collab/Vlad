{
  "name": "w-studio",
  "private": true,
  "version": "0.1.0",
  "description": "W Studio — мобильный редактор фото и видео (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "build:local": "node scripts/build-local.mjs",
    "build:single": "node scripts/build-local.mjs --single"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
